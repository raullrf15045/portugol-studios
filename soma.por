programa {
	inteiro n1, n2, s // Declaração das variaveis
	// Tipos de dados
	// inteiro -> numreros inteiros
	// real -> numeros decimais
	// caracter -> um caracter
	// cadeia -> texto
	// logico -> verdadeiro ou falso

	funcao inicio () {
		n1 = 5 // Inicializaçao  da variavel
		escreva ("Digite o valor de n2: ")
		leia (n2)
		s = n1 + n2 
		escreva ("A soma de ", n1, " com ",n2, " é igual a ", s)
  	}
}
